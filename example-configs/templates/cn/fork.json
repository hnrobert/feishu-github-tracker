{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "🍴 Fork：{{forkee.full_name}}"
            },
            "template": "purple"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Fork者：** {{sender_link_md | default(sender.login)}}\n**目标仓库：** {{forkee.full_name}}\n"
              }
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "查看Fork仓库"
                  },
                  "url": "{{forkee.html_url}}",
                  "type": "primary"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
