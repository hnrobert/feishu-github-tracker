{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "📝 PR 审查 {{action}}：#{{pull_request.number}}"
            },
            "template": "cyan"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**审查者：** {{review_user_link_md | default(review.user.login)}}\n**PR：** #{{pull_request.number}} {{pull_request.title}}\n**结果：** {{review.state}}\n{{review.body}}\n"
              }
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "查看审查"
                  },
                  "url": "{{review.html_url}}",
                  "type": "primary"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "tags": [
        "dismissed"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
