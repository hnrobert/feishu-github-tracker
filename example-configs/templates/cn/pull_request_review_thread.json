{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "💬 PR审核讨论{{action}}"
            },
            "template": "blue"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**PR：** #{{pull_request.number}} {{pull_request.title}}\n**讨论：** {{thread_comments | length}} 条评论\n**操作：** {{action}}\n"
              }
            }
          ]
        }
      }
    },
    {
      "tags": [
        "resolved"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "🔔 pull_request_review_thread 已解决"
            },
            "template": "green"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**仓库：** {{repository_link_md}}\n**操作：** {{action}}\n**用户：** {{sender_link_md}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "查看详情"
                  },
                  "url": "{{repository.html_url}}",
                  "type": "default"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "tags": [
        "unresolved"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "🔔 pull_request_review_thread unresolved"
            },
            "template": "turquoise"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**仓库：** {{repository_link_md}}\n**操作：** {{action}}\n**用户：** {{sender_link_md}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "查看详情"
                  },
                  "url": "{{repository.html_url}}",
                  "type": "default"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
