      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "🔒 安全通告：{{action}}"
            },
            "template": "red"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**通告：** {{security_advisory.summary | default('详情请查看安全通告')}}\n**严重度：** {{security_advisory.severity | default('N/A')}}\n"
              }
            }
          ]
        }
      }
