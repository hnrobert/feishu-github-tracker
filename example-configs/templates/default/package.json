{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "\ud83d\udce6 Package: {{action}} {{package.name | default('package')}}"
            },
            "template": "purple"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Package:** {{package_link_md | default(package.name)}}\n**Action:** {{action}}\n**Type:** {{package.package_type | default('')}}\n**Version/Tag:** {{package.version | default('')}} {{package_tag_name | default(package.tag_name | default(''))}}\n**Published by:** {{sender_link_md | default(pusher_link_md | default(''))}}\n"
              }
            }
          ]
        }
      }
    },
    {
      "tags": [
        "published"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "\ud83d\udd14 Package Published"
            },
            "template": "green"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Repository:** {{repository_link_md}}\n**Action:** {{action}}\n**User:** {{sender_link_md}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "View Details"
                  },
                  "url": "{{repository.html_url}}",
                  "type": "default"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "tags": [
        "updated"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "\ud83d\udd14 Package Updated"
            },
            "template": "blue"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Repository:** {{repository_link_md}}\n**Action:** {{action}}\n**User:** {{sender_link_md}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "View Details"
                  },
                  "url": "{{repository.html_url}}",
                  "type": "default"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
