{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "\ud83d\udcdd PR Review {{action}}: #{{pull_request.number}}"
            },
            "template": "cyan"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Reviewer:** {{review_user_link_md | default(review.user.login)}}\n**PR:** #{{pull_request.number}} {{pull_request.title}}\n**Conclusion:** {{review.state}}\n{{review.body}}\n"
              }
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "View Review"
                  },
                  "url": "{{review.html_url}}",
                  "type": "primary"
                }
              ]
            }
          ]
        }
      }
    },
    {
