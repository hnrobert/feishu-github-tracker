      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "🚀 Release Published"
            },
            "template": "green"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Repository:** {{repository_link_md}}\n**Version:** {{release.tag_name}}\n**Release Name:** {{release.name}}\n**Published by:** {{sender_link_md}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "{{release.body}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "View Release"
                  },
                  "url": "{{release.html_url}}",
                  "type": "primary"
                }
              ]
            }
          ]
