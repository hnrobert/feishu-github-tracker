{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "\ud83d\udcac PR Review Thread {{action}}"
            },
            "template": "blue"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**PR:** #{{pull_request.number}} {{pull_request.title}}\n**Thread:** {{thread_comments | length}} comments\n**Action:** {{action}}\n"
              }
            }
          ]
        }
      }
    },
    {
      "tags": [
        "resolved"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "\ud83d\udd14 Pull Request Review Thread Resolved"
            },
            "template": "green"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Repository:** {{repository_link_md}}\n**Action:** {{action}}\n**User:** {{sender_link_md}}"
              }
            },
            {
              "tag": "hr"
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "View Details"
                  },
                  "url": "{{repository.html_url}}",
                  "type": "default"
                }
              ]
            }
          ]
        }
      }
    },
