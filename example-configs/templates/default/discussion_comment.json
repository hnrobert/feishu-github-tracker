{
  "payloads": [
    {
      "tags": [
        "default"
      ],
      "payload": {
        "msg_type": "interactive",
        "card": {
          "config": {
            "wide_screen_mode": true
          },
          "header": {
            "title": {
              "tag": "plain_text",
              "content": "💬 Discussion Comment: {{discussion.title}}"
            },
            "template": "teal"
          },
          "elements": [
            {
              "tag": "div",
              "text": {
                "tag": "lark_md",
                "content": "**Author:** {{sender_link_md | default(sender.login)}}\n**Discussion:** {{discussion.title}}\n**Comment:** {{comment.body}}\n"
              }
            },
            {
              "tag": "action",
              "actions": [
                {
                  "tag": "button",
                  "text": {
                    "tag": "plain_text",
                    "content": "View Comment"
                  },
                  "url": "{{comment.html_url}}",
                  "type": "primary"
                }
              ]
            }
          ]
        }
      }
    },
